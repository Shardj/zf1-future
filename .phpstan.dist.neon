includes:
    - .phpstan.dist.baseline.php
    - phar://phpstan.phar/conf/bleedingEdge.neon
parameters:
    phpVersion:
        min: 70400
        max: 80599
    paths:
        - library
    excludePaths:
        - library/Zend/Search/Lucene/MultiSearcher.php
        - library/Zend/Service/WindowsAzure/Log/Writer/WindowsAzure.php
        - library/Zend/Test/PHPUnit/
        # Deprecated components (see README.md); they are not tested either
        - library/Zend/Cache/Backend/Sqlite.php
        - library/Zend/Cache/Backend/WinCache.php
        - library/Zend/Cache/Backend/Xcache.php
        - library/Zend/Cache/Backend/ZendPlatform.php
        - library/Zend/Cache/Backend/ZendServer.php
        - library/Zend/Cache/Backend/ZendServer/
        - library/Zend/Filter/Compress/Rar.php
        - library/Zend/Filter/Encrypt/Mcrypt.php
        - library/Zend/Http/UserAgent/Features/Adapter/DeviceAtlas.php
        - library/Zend/Http/UserAgent/Features/Adapter/TeraWurfl.php
        - library/Zend/Queue/Adapter/Memcacheq.php
        - library/Zend/Queue/Adapter/PlatformJobQueue.php
        - library/Zend/Queue/Message/PlatformJob.php
        - library/Zend/Serializer/Adapter/Wddx.php
        - library/Zend/Service/Ebay/
        - library/Zend/Amf/
        - library/Zend/Captcha/ReCaptcha.php
        - library/Zend/Cloud/
        - library/Zend/Form/Decorator/Captcha/ReCaptcha.php
        - library/Zend/Gdata.php
        - library/Zend/Gdata/
        - library/Zend/Serializer/Adapter/Amf0.php
        - library/Zend/Serializer/Adapter/Amf3.php
        - library/Zend/Service/Amazon.php
        - library/Zend/Service/Amazon/Accessories.php
        - library/Zend/Service/Amazon/CustomerReview.php
        - library/Zend/Service/Amazon/EditorialReview.php
        - library/Zend/Service/Amazon/Image.php
        - library/Zend/Service/Amazon/Item.php
        - library/Zend/Service/Amazon/ListmaniaList.php
        - library/Zend/Service/Amazon/Offer.php
        - library/Zend/Service/Amazon/OfferSet.php
        - library/Zend/Service/Amazon/Query.php
        - library/Zend/Service/Amazon/ResultSet.php
        - library/Zend/Service/Amazon/SimilarProduct.php
        - library/Zend/Service/Audioscrobbler.php
        - library/Zend/Service/Delicious.php
        - library/Zend/Service/Delicious/
        - library/Zend/Service/ReCaptcha.php
        - library/Zend/Service/ReCaptcha/
        - library/Zend/Service/Yahoo.php
        - library/Zend/Service/Yahoo/
    level: 5
    tmpDir: .phpstan.cache
    checkFunctionNameCase: true
    checkInternalClassCaseSensitivity: true
    treatPhpDocTypesAsCertain: false
    # Members of classes with __get() / __set() / __call() are resolved at runtime (Zend_Pdf_Element_*, Zend_Config,
    # Zend_Soap_Client, ...), so an unknown member of such a class is not reported
    reportMagicMethods: false
    reportMagicProperties: false
    ignoreErrors:
        # The library has no namespaces: @internal marks members used by other components of the library
        - identifier: method.internal
        - identifier: staticMethod.internal
        - identifier: method.internalClass
        - identifier: property.internalClass
        - identifier: new.internalClass
        - identifier: class.extendsInternalClass
